# Copy this file to .env and fill in your own values before running the app.
# Never commit the real .env file to git.

# A long random string used to sign JWT tokens. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-this-with-a-random-generated-secret

# How long a login session stays valid, in minutes.
ACCESS_TOKEN_EXPIRE_MINUTES=60

# SQLite is the default — zero setup, just a local file. Leave as-is unless
# you specifically want Postgres/MySQL.
DATABASE_URL=sqlite:///./spam_detector.db
